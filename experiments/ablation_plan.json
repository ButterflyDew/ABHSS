{
  "schema_version": 1,
  "status": "preregistered-before-results",
  "paper_role": "minimal mechanism ablation; separate from the formal P1/P2/S2 matrix",
  "source_suite": "P2_cross_g",
  "timeout_seconds_per_query": 10000,
  "selection": {
    "datasets": [
      "Musae-GPU4GST",
      "Youtube-GPU4GST",
      "Orkut-GPU4GST"
    ],
    "size_classes": [
      "small",
      "medium",
      "large"
    ],
    "g": [
      6,
      10,
      14
    ],
    "panel_query_indices": [
      1,
      2,
      3,
      4,
      5
    ],
    "panel_tranche": 1,
    "cells": 9,
    "queries": 45,
    "selection_rule": "fixed before ablation timing; one graph per size/structure regime, three predeclared group counts, and one query from each of five input-size strata"
  },
  "shared_execution_contract": {
    "single_compute_thread": true,
    "same_machine_and_toolchain_as_main": true,
    "no_per_query_configuration_selection": true,
    "correctness_gate": [
      "repository CTest",
      "zero-weight witness fixture",
      "independent exact small-graph comparison"
    ],
    "required_output": [
      "status",
      "solution_status",
      "weight",
      "solver_seconds",
      "peak_rss_mib",
      "mask_vertex_states"
    ]
  },
  "panels": [
    {
      "id": "configuration_chain",
      "question": "incremental contribution of DirectedCut and the Adjoint replacement",
      "variants": [
        {
          "id": "base",
          "executable": "build/abhss",
          "arguments": [
            "--enhancements=none"
          ],
          "reuse_matching_main_records": true
        },
        {
          "id": "directed_cut_only",
          "executable": "build/abhss",
          "arguments": [
            "--enhancements=directed-cut"
          ],
          "reuse_matching_main_records": false
        },
        {
          "id": "enhanced",
          "executable": "build/abhss",
          "arguments": [
            "--enhancements=all"
          ],
          "reuse_matching_main_records": true
        }
      ],
      "new_tasks": 45
    },
    {
      "id": "common_a1_endpoint_floor",
      "question": "contribution of endpoint-floor inside the common A1 continuation cone",
      "production_variants": [
        "base",
        "enhanced"
      ],
      "ablated_variants": [
        "without_endpoint_floor_base",
        "without_endpoint_floor_enhanced"
      ],
      "isolated_build": {
        "executable": "build-ablation-no-endpoint-floor/abhss",
        "source_file": "src/abhss/core.cpp",
        "symbol": "AnchoredSingletonContinuation",
        "only_allowed_semantic_change": {
          "production": "max(FarthestRemaining(...), TourLowerBound::EndpointFloorAt(...))",
          "ablation": "FarthestRemaining(...)"
        },
        "forbidden": "runtime switch, graph/g/time/state-dependent branch, or any other source/configuration change",
        "exactness": "FarthestRemaining remains an admissible 1-Lipschitz continuation; this weakens pruning only"
      },
      "new_tasks": 90
    }
  ],
  "total_new_tasks": 135,
  "reporting": [
    "completed/5",
    "PAR-2",
    "paired runtime on jointly completed queries",
    "peak RSS",
    "mask_vertex_states",
    "timeout direction"
  ],
  "stop_conditions": [
    "any objective or feasibility mismatch",
    "isolated build diff is not exactly the registered semantic change"
  ],
  "interpretation_guards": [
    "do not combine per-query best variants",
    "do not use ablation to replace main experiments",
    "report regressions and timeouts without removing cells"
  ]
}
